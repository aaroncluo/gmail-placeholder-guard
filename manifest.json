{
  "manifest_version": 3,
  "name": "Free Placeholder Guard for Gmail",
  "version": "1.0.3",
  "description": "Never accidentally send \"Hi [Name]\" again. Catch embarrassing placeholders before your emails are sent. 100% free and automatic.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["detector.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
