{
  "manifest_version": 3,
  "name": "Placeholder Guard for Gmail",
  "version": "1.0.2",
  "description": "Warns before you send a Gmail message that still contains [square-bracket] placeholders. Checks happen entirely in your browser.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["detector.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
